# Template for .env — copy it to .env and fill in your own values.
# .env holds real keys and is git-ignored; this file is committed so teammates know which settings exist.

# NASA Earthdata credentials for authenticated data backends.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Website: Google Gemini explanations (get a key at https://aistudio.google.com/apikey).
# Leave empty to use the built-in bilingual explanation template.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Website: unit conversion (model works in USD/ha; the site shows Taka per bigha).
USD_TO_BDT=122
HA_PER_BIGHA=0.13355

# Optional: database seeder writes to MySQL as well as SQLite when these are set.
# MYSQL_HOST=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=field_shift_db
# MYSQL_PORT=3306
